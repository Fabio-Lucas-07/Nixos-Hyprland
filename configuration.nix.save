{ config, pkgs, lib, ... }:

{
  imports =
    [
      # Lanzaboote e Home Manager agora são injetados pelo flake.nix
      # hardware-configuration.nix também foi movido para o flake.nix para melhor estrutura,
      # mas mantê-lo aqui ou lá não quebra o sistema. Deixaremos apenas vazio aqui ou omitido.
    ];

  # Home manager
  home-manager.useGlobalPkgs = true;
  home-manager.useUserPackages = true;

  home-manager.users.fabio = {
    imports = [ ./home.nix ];
  };

  # ==========================================
  # BOOT & KERNEL OPTIMIZATIONS
  # ==========================================
  boot.loader.efi.canTouchEfiVariables = true;
  boot.loader.systemd-boot.configurationLimit = 2;

  # Bootloader e Lanzaboote
  boot.loader.systemd-boot.enable = lib.mkForce false;

  boot.lanzaboote = {
    enable = true;
    pkiBundle = "/etc/secureboot";
  };

  boot.kernelPackages = pkgs.linuxPackages;
  hardware.cpu.amd.updateMicrocode = true;

  boot.kernelModules = [ "tcp_bbr" ]; # Network Congestion Control
  boot.kernel.sysctl = {
    "net.ipv4.tcp_congestion_control" = "bbr";
    "net.core.default_qdisc" = "fq";
    "net.core.wmem_max" = 1073741824;
    "net.core.rmem_max" = 1073741824;
    "net.ipv4.tcp_rmem" = "4096 87380 1073741824";
    "net.ipv4.tcp_wmem" = "4096 87380 1073741824";
  };

  powerManagement.cpuFreqGovernor = "performance";

  # ==========================================
  # GPU / GRAPHICS CONFIGURATION
  # ==========================================
  hardware.graphics = {
    enable = true;
    enable32Bit = true; # Required for Steam
  };

  services.xserver.videoDrivers = [ "nvidia" ];

  hardware.nvidia = {
    modesetting.enable = true;
    powerManagement.enable = false;
    powerManagement.finegrained = true;
    open = false;
    nvidiaSettings = true;
    package = config.boot.kernelPackages.nvidiaPackages.stable;

    # PRIME CONFIGURATION (Hybrid Graphics)
    prime = {
      offload = {
        enable = true;
        enableOffloadCmd = true;
      };
      nvidiaBusId = "PCI:1:0:0";
      amdgpuBusId = "PCI:4:0:0";
    };
  };

  # ==========================================
  # NETWORKING & LOCALE
  # ==========================================
  networking.hostName = "nixos";
  networking.networkmanager.enable = true;
  services.timesyncd.enable = true;

  time.timeZone = "America/Sao_Paulo";
  time.hardwareClockInLocalTime = true;

  i18n.defaultLocale = "en_US.UTF-8";
  i18n.extraLocaleSettings = {
    LC_ADDRESS = "pt_BR.UTF-8";
    LC_IDENTIFICATION = "pt_BR.UTF-8";
    LC_MEASUREMENT = "pt_BR.UTF-8";
    LC_MONETARY = "pt_BR.UTF-8";
    LC_NAME = "pt_BR.UTF-8";
    LC_NUMERIC = "pt_BR.UTF-8";
    LC_PAPER = "pt_BR.UTF-8";
    LC_TELEPHONE = "pt_BR.UTF-8";
    LC_TIME = "pt_BR.UTF-8";
  };

  # ==========================================
  # DESKTOP ENVIRONMENT & DISPLAY MANAGER
  # ==========================================
  services.xserver.enable = true;

  services.displayManager.gdm.enable = true;
  #Desktop Gnome
  services.desktopManager.gnome.enable = false;

  programs.niri.enable = true;

  services.xserver.xkb = {
    layout = "us";
    variant = "intl";
  };
  console.keyMap = "us-acentos";

  xdg.portal = {
    enable = true;
    extraPortals = with pkgs; [ 
      xdg-desktop-portal-gnome 
      xdg-desktop-portal-gtk 
    ];
    config = {
      niri = {
        default = [ "gnome" "gtk" ];
        "org.freedesktop.impl.portal.Screencast" = "gnome";
        "org.freedesktop.impl.portal.Screenshot" = "gnome";
      };
      common = {
        default = [ "gtk" ];
      };
    };
  };

  # ==========================================
  # FONTS
  # ==========================================
  fonts.packages = with pkgs; [
    inter
    jetbrains-mono
    nerd-fonts.iosevka
    udev-gothic-nf
    noto-fonts
    liberation_ttf
  ];

  fonts.fontconfig = {
    enable = true;
    hinting.style = "slight";
    subpixel.rgba = "rgb";
  };

  # ==========================================
  # AUDIO, BLUETOOTH & RGB
  # ==========================================
  services.pulseaudio.enable = false;
  security.rtkit.enable = true;
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    alsa.support32Bit = true;
    pulse.enable = true;
  };
  services.blueman.enable = true;

  hardware.bluetooth.enable = true;
  hardware.bluetooth.powerOnBoot = true;

  services.hardware.openrgb = {
    enable = true;
    startupProfile = "Default";
  };

  # ==========================================
  # PROGRAMS & SERVICES
  # ==========================================
  programs.zsh.enable = true;
  programs.dconf.enable = true;
  programs.firefox.enable = true;
  services.flatpak.enable = true;
  services.cron.enable = true;
  services.printing.enable = true;
  services.openssh.enable = true;

  programs.steam = {
    enable = true;
    remotePlay.openFirewall = true;
    dedicatedServer.openFirewall = true;
  };
  programs.gamemode.enable = true;

  virtualisation.libvirtd.enable = true;
  virtualisation.docker.enable = true;
  programs.virt-manager.enable = true;

  services.power-profiles-daemon.enable = true;

  # ==========================================
  # ZRAM SWAP
  # ==========================================
  zramSwap = {
    enable = true;
    memoryPercent = 50;
  };

  # ==========================================
  # POSTGRESQL
  # ==========================================
  services.postgresql = {
    enable = true;
    authentication = ''
      # TYPE  DATABASE        USER            ADDRESS                 METHOD
      host    all             all             127.0.0.1/32            trust
      host    all             all             ::1/128                 trust
    '';
  };

  # ==========================================
  # NIX SETTINGS
  # ==========================================
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  nixpkgs.config.allowUnfree = true;

  nix.gc = {
    automatic = true;
    dates = "daily";
    options = "--delete-older-than 14d";
  };

  # ==========================================
  # USER CONFIGURATION & SECURITY
  # ==========================================
  users.users."fabio" = {
    isNormalUser = true;
    description = "Fabio";
    extraGroups = [ "networkmanager" "wheel" "video" "adbusers" "libvirtd" ];
    shell = pkgs.zsh;
  };


  users.defaultUserShell = pkgs.zsh;

  security.sudo.extraRules = [
    {
      users = [ "fabio" ];
      commands = [
        {
          command = "ALL";
          options = [ "NOPASSWD" ];
        }
      ];
    }
  ];

  services.logind.settings.Login = {
    HandlePowerKey = "ignore";
  };

  # ==========================================
  # SYSTEM PACKAGES
  # ==========================================
  environment.pathsToLink = [ "/share/gsettings-schemas" ];

  environment.systemPackages = with pkgs; [
    # Core & CLI Utilities
    wget curl git btop fzf direnv zbar p7zip fastfetch
    yq-go wmctrl inotify-tools lavat file pipes clock-rs cbonsai killall
    psmisc eww swappy slurp grim playerctl satty cmatrix sl nodejs gh

    # Development
    maven jdk21 python3 android-tools
    pgadmin4-desktopmode  neovim
    pkgsCross.mingwW64.stdenv.cc

    # Desktop Apps & Theming
    brave vesktop telegram-desktop obsidian onlyoffice-desktopeditors
    libreoffice-qt hunspell hunspellDicts.ru_RU hunspellDicts.en_US papers
    kdePackages.kolourpaint mission-center glaxnimate inkscape
    hicolor-icon-theme papirus-icon-theme nwg-look
    insomnia hicolor-icon-theme spotify linux-wallpaperengine

    # Media & Gaming
    mpv obs-studio gpu-screen-recorder ffmpeg qbittorrent bottles steam-run

    # System & Wayland Tools
    kitty alacritty taskwarrior3 zenity matugen xdg-desktop-portal-gtk
    mpvpaper power-profiles-daemon
    xdg-user-dirs imagemagick xwayland-satellite 
    
    # O Noctalia Shell foi adicionado aqui
    noctalia-shell

    # FIX: Quickshell com os módulos Qt injetados
    (quickshell.overrideAttrs (oldAttrs: {
      buildInputs = (oldAttrs.buildInputs or []) ++ (with qt6; [
        qtsvg
        qtmultimedia
        qtimageformats
        qtwayland
        qtdeclarative
        qt5compat
      ]);
    }))
  ];

  system.stateVersion = "26.05";
}
